# Especialista Microbiólogo — CRIZA
# Copiar a .env y completar con valores reales

ANTHROPIC_API_KEY=sk-ant-...

# Modelo para este agente (default: claude-sonnet-5). Acepta "proveedor/modelo"
# (utils/ai_client.py::resolver_modelo) — sin proveedor, asume Anthropic.
MICROBIOLOGO_MODEL=claude-sonnet-5

# BacDive (fenotipo de cepas bacterianas, search_bacdive) — API pública sin auth desde
# febrero 2026, no requiere nada acá.

