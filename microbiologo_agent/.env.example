# Especialista Microbiólogo — CRIZA
# Copiar a .env y completar con valores reales

ANTHROPIC_API_KEY=sk-ant-...

# Modelo para este agente (default: claude-sonnet-4-6). Acepta "proveedor/modelo"
# (utils/ai_client.py::resolver_modelo) — sin proveedor, asume Anthropic.
MICROBIOLOGO_MODEL=claude-sonnet-4-6

# BacDive (fenotipo de cepas bacterianas) — registro gratis en https://api.bacdive.dsmz.de/
# Sin esto, search_bacdive devuelve un error explícito (no rompe el resto del agente).
BACDIVE_EMAIL=
BACDIVE_PASSWORD=

# KM — ver criza/.env.example (root) para el set completo
