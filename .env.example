# Config compartida por scripts de criza/ que corren desde la raíz (ingest_corrida.py,
# ingest_historico.py, migrate_*.py) y por el Knowledge Module (paquete instalado por pip, no lee
# ningún .env propio — ver knowledge_module/auditor/__main__.py). Copiar a .env y completar con
# los valores reales. Cada agente (market_agent/, evidence_generalista/, etc.) tiene además su
# propio .env.example con su ANTHROPIC_API_KEY/modelo — ver el comentario en cada uno.

# Usado por ingest_corrida.py / ingest_historico.py (no viven bajo ningún agente específico)
ANTHROPIC_API_KEY=sk-ant-...

DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Branch de staging (Neon, copy-on-write de production) — ver docs/STAGING.md. Usar para
# cualquier trabajo de escritura nuevo en vez de DATABASE_URL de producción.
DATABASE_URL_STAGING=postgresql+asyncpg://user:password@host-del-branch-staging/dbname?ssl=require

# Embeddings — local: sentence-transformers (dev, sin API key) / bgem3: servicio remoto (prod)
EMBEDDING_PROVIDER=bgem3
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=1024
BGEM3_URL=https://criza-dev--criza-bge-m3-embed-server.modal.run

# knowledge_module.document_store — dónde guarda los PDFs descargados (el paquete no elige por
# sí mismo, cada instancia es dueña de sus propios datos). Path relativo a donde corren los
# scripts (raíz de criza/). El código arma {KM_DOCUMENT_STORE_DIR}/{instance}/{hash}.pdf.
KM_DOCUMENT_STORE_DIR=document_store_data
