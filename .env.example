# Copiar como .env y completar con tus claves reales
# cp .env.example .env

# --- Requerido ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Modelos por agente (routing de modelo — economía de tokens) ---
# Scout multidominio: barato, corre muchas veces sobre muchos candidatos
SCOUT_MODEL=claude-sonnet-4-6
# Especialista proteínas: análisis profundo, corre poco sobre candidatos filtrados
# Opciones: claude-sonnet-4-6 (default) | claude-opus-4-5 (más potente, más caro)
SPECIALIST_MODEL=claude-sonnet-4-6

# --- Opcional: mejora rate limits ---
# Sin key: 100 req/5min en Semantic Scholar
# Con key: 1 req/seg
SEMANTIC_SCHOLAR_API_KEY=

# NCBI PubMed (fallback, no requerido)
# Sin key: ~3 req/seg | Con key: 10 req/seg
# NCBI_API_KEY=

# --- ProteinMPNN (ML-based variant design) ---
# Requerido solo para design_variants_mpnn tool.
# Setup: git clone https://github.com/dauparas/ProteinMPNN.git ~/ProteinMPNN
#        pip install torch --index-url https://download.pytorch.org/whl/cpu
# PROTEINMPNN_PATH=/root/ProteinMPNN

# --- FoldX (predicción ΔΔG y ΔTm) ---
# Requerido solo para predict_tm_change tool.
# Setup: registrarse en https://foldxsuite.biocomputing.eu (gratis académico)
#        descargar binario para tu OS y extraer
# Apuntar al binario directamente (no al directorio):
# FOLDX_PATH=/root/foldx/foldx

# --- ESMFold (predicción de estructura para proteínas >200aa) ---
# Requerido para predict_structure_local con proteínas largas.
# Sin esta variable: el agente hace fallback a la API pública de ESMFold (máx 200aa).
#
# Setup (Modal — serverless, sin gestión de pods):
#   Ver services/esmfold/README.md para instrucciones completas.
#   1. pip install modal && modal setup
#   2. modal run services/esmfold/modal_app.py::download_model   (una sola vez, ~14GB)
#   3. modal deploy services/esmfold/modal_app.py
#   4. Copiar la URL que imprime el deploy acá abajo
#
# Formato: https://<usuario>--criza-esmfold-esmfold-server.modal.run
# Cold start: ~30-60s | Costo por predicción: ~$0.03 | Sin idle cost
ESMFOLD_POD_URL=https://criza-dev--criza-esmfold-esmfold-server.modal.run
