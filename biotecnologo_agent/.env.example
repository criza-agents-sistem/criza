# Especialista Biotecnólogo — CRIZA
# Copiar a .env y completar con valores reales

ANTHROPIC_API_KEY=sk-ant-...

# Modelo para este agente (default: claude-sonnet-5). Acepta "proveedor/modelo"
# (utils/ai_client.py::resolver_modelo) — sin proveedor, asume Anthropic.
BIOTECNOLOGO_MODEL=claude-sonnet-5

# PubMed (NCBI E-utilities) — sin key: ~3 req/seg. Con key (opcional, gratis en
# ncbi.nlm.nih.gov/account): 10 req/seg.
# NCBI_API_KEY=

# KM — ver criza/.env.example (root) para el set completo
