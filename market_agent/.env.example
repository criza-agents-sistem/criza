# Agente de Mercado CRIZA v0 — variables de entorno

# Anthropic — misma key que scientific_agent
ANTHROPIC_API_KEY=sk-ant-...

# COMTRADE API key (registro gratuito en comtrade.un.org)
# Sin esta key, get_import_data retorna error con instrucciones
COMTRADE_API_KEY=

# Modelo para el agente de mercado
# Default: claude-sonnet-4-6
MARKET_MODEL=claude-sonnet-4-6
