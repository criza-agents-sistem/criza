# Agente Financiero CRIZA — variables de entorno

# Anthropic — misma key que el resto de los agentes (necesaria: cliente nativo por web_search,
# ver docs/DESIGN_GATE.md decisión C)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo para el agente financiero
# Default: claude-sonnet-5
FINANCIERO_MODEL=claude-sonnet-5

# COMTRADE — importaciones reales de Argentina por código HS (registro gratuito en
# comtrade.un.org). Usada para benchmarking de costos/precios (ver docs/DESIGN_GATE.md decisión
# E). Sin esta key, get_import_data devuelve un error claro con instrucciones — no bloquea al
# agente, ese ítem queda a-confirmar o se pide vía pedir_informacion_faltante.
COMTRADE_API_KEY=
